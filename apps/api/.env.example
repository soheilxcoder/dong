# ---- Dong server configuration (copy to .env) ----
PORT=4000
# Long random string. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
# Where the SQLite database file lives (back this file up!)
DATABASE_FILE=./data/dong.db
UPLOAD_DIR=./data/uploads
# Public URL where users open the app (used in invite links / QR)
PUBLIC_APP_URL=https://dong.example.com/
# Allowed browser origins (comma separated). Leave * if the web app is served by this same server.
CORS_ORIGIN=*
# Optional: folder with the built web app (auto-detected: ./web or ../web/dist)
# WEB_DIR=./web
# Optional Web Push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
