# Plesk / Apache: this repository is deployed to the document root of https://dong.arounidea.com/
# The pre-built app (index.html, assets/, …) is committed into the repo root by .github/workflows/plesk.yml.
Options -Indexes
RewriteEngine On
RewriteBase /

# Block source folders and dotfiles
RewriteRule ^(\.git|\.github|apps|packages|scripts|tools|docs-src|store-assets|release-keys|node_modules|package(-lock)?\.json|tsconfig.*|\.htaccess)(/|$) - [R=404,L]

# The built app sits right here in the document root (index.html, assets/, …); /api/ is PHP, /apk/ the Android build.
# Hash router → no SPA fallback needed. Unknown paths fall through to 404.html.
ErrorDocument 404 /404.html

# Correct MIME + no-cache for entry points, long cache for hashed assets
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType font/woff2 .woff2
  AddType image/webp .webp
  AddType application/vnd.android.package-archive .apk
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|woff2|png|webp|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^(index\.html|sw\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
