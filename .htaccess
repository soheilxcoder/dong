# Plesk / Apache: this repository is deployed to <domain>/httpdocs/dong
# Serve the pre-built static app from deploy/dong/ and hide everything else.
Options -Indexes
RewriteEngine On
RewriteBase /dong/

# Block source folders and dotfiles
RewriteRule ^(\.git|\.github|apps|packages|scripts|tools|docs-src|store-assets|release-keys|node_modules|package(-lock)?\.json|tsconfig.*|\.htaccess)(/|$) - [R=404,L]

# Everything under /dong/* is served from /dong/deploy/dong/*
RewriteCond %{REQUEST_URI} !^/dong/deploy/dong/
RewriteRule ^(.*)$ deploy/dong/$1 [L]

# Correct MIME + no-cache for entry points, long cache for hashed assets
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType font/woff2 .woff2
  AddType image/webp .webp
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|woff2|png|webp|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^(index\.html|sw\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
